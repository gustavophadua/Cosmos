{"id": "P-001", "texto": {"premissas": ["Todo pato é esperto."], "conclusao": "Algum pato é esperto."}, "vocabulario": [{"simbolo": "Pato", "tipo": "predicado", "aridade": 1, "leitura": "x é pato (pata)"}, {"simbolo": "Esperto", "tipo": "predicado", "aridade": 1, "leitura": "x é esperto"}], "gabarito": {"premissas": ["∀x (Pato(x) ⟹ Esperto(x))"], "conclusao": "∃x (Pato(x) ∧ Esperto(x))", "classe": "independente"}}
{"id": "P-002", "texto": {"premissas": ["Tom é curioso ou ruidoso.", "Tom não é curioso."], "conclusao": "Tom é ruidoso."}, "vocabulario": [{"simbolo": "tom", "tipo": "constante", "aridade": 0, "leitura": "Tom"}, {"simbolo": "Curioso", "tipo": "predicado", "aridade": 1, "leitura": "x é curioso"}, {"simbolo": "Ruidoso", "tipo": "predicado", "aridade": 1, "leitura": "x é ruidoso"}], "gabarito": {"premissas": ["Curioso(tom) ∨ Ruidoso(tom)", "¬Curioso(tom)"], "conclusao": "Ruidoso(tom)", "classe": "segue"}}
{"id": "P-003", "texto": {"premissas": ["Nala é ruidosa só se é mansa.", "Nala é mansa."], "conclusao": "Nala é ruidosa."}, "vocabulario": [{"simbolo": "nala", "tipo": "constante", "aridade": 0, "leitura": "Nala"}, {"simbolo": "Ruidoso", "tipo": "predicado", "aridade": 1, "leitura": "x é ruidoso"}, {"simbolo": "Manso", "tipo": "predicado", "aridade": 1, "leitura": "x é manso"}], "gabarito": {"premissas": ["Ruidoso(nala) ⟹ Manso(nala)", "Manso(nala)"], "conclusao": "Ruidoso(nala)", "classe": "independente"}}
{"id": "P-004", "texto": {"premissas": ["Mel é loba ou macaca.", "Mel não é loba."], "conclusao": "Mel não é macaca."}, "vocabulario": [{"simbolo": "mel", "tipo": "constante", "aridade": 0, "leitura": "Mel"}, {"simbolo": "Lobo", "tipo": "predicado", "aridade": 1, "leitura": "x é lobo (loba)"}, {"simbolo": "Macaco", "tipo": "predicado", "aridade": 1, "leitura": "x é macaco (macaca)"}], "gabarito": {"premissas": ["Lobo(mel) ∨ Macaco(mel)", "¬Lobo(mel)"], "conclusao": "¬Macaco(mel)", "classe": "contradiz"}}
{"id": "P-005", "texto": {"premissas": ["Todo lobo é manso.", "Tom é manso."], "conclusao": "Tom é lobo."}, "vocabulario": [{"simbolo": "Lobo", "tipo": "predicado", "aridade": 1, "leitura": "x é lobo (loba)"}, {"simbolo": "Manso", "tipo": "predicado", "aridade": 1, "leitura": "x é manso"}, {"simbolo": "tom", "tipo": "constante", "aridade": 0, "leitura": "Tom"}], "gabarito": {"premissas": ["∀x (Lobo(x) ⟹ Manso(x))", "Manso(tom)"], "conclusao": "Lobo(tom)", "classe": "independente"}}
{"id": "P-006", "texto": {"premissas": ["Todo coelho é manso."], "conclusao": "Nem todo coelho é manso."}, "vocabulario": [{"simbolo": "Coelho", "tipo": "predicado", "aridade": 1, "leitura": "x é coelho (coelha)"}, {"simbolo": "Manso", "tipo": "predicado", "aridade": 1, "leitura": "x é manso"}], "gabarito": {"premissas": ["∀x (Coelho(x) ⟹ Manso(x))"], "conclusao": "¬∀x (Coelho(x) ⟹ Manso(x))", "classe": "contradiz"}}
{"id": "P-007", "texto": {"premissas": ["Há um cachorro que todo cavalo persegue."], "conclusao": "Todo cavalo persegue algum cachorro."}, "vocabulario": [{"simbolo": "Cavalo", "tipo": "predicado", "aridade": 1, "leitura": "x é cavalo (égua)"}, {"simbolo": "Persegue", "tipo": "predicado", "aridade": 2, "leitura": "x persegue y"}, {"simbolo": "Cachorro", "tipo": "predicado", "aridade": 1, "leitura": "x é cachorro (cachorra)"}], "gabarito": {"premissas": ["∃y (Cachorro(y) ∧ ∀x (Cavalo(x) ⟹ Persegue(x, y)))"], "conclusao": "∀x (Cavalo(x) ⟹ ∃y (Cachorro(y) ∧ Persegue(x, y)))", "classe": "segue"}}
{"id": "P-008", "texto": {"premissas": ["Nenhum macaco é ruidoso.", "Tom é macaco."], "conclusao": "Tom é ruidoso."}, "vocabulario": [{"simbolo": "Macaco", "tipo": "predicado", "aridade": 1, "leitura": "x é macaco (macaca)"}, {"simbolo": "Ruidoso", "tipo": "predicado", "aridade": 1, "leitura": "x é ruidoso"}, {"simbolo": "tom", "tipo": "constante", "aridade": 0, "leitura": "Tom"}], "gabarito": {"premissas": ["∀x (Macaco(x) ⟹ ¬Ruidoso(x))", "Macaco(tom)"], "conclusao": "Ruidoso(tom)", "classe": "contradiz"}}
{"id": "P-009", "texto": {"premissas": ["Todo cavalo é cachorro.", "Rex é cavalo."], "conclusao": "Algum cavalo é cachorro."}, "vocabulario": [{"simbolo": "Cavalo", "tipo": "predicado", "aridade": 1, "leitura": "x é cavalo (égua)"}, {"simbolo": "Cachorro", "tipo": "predicado", "aridade": 1, "leitura": "x é cachorro (cachorra)"}, {"simbolo": "rex", "tipo": "constante", "aridade": 0, "leitura": "Rex"}], "gabarito": {"premissas": ["∀x (Cavalo(x) ⟹ Cachorro(x))", "Cavalo(rex)"], "conclusao": "∃x (Cavalo(x) ∧ Cachorro(x))", "classe": "segue"}}
{"id": "P-010", "texto": {"premissas": ["Todo urso é pato.", "Todo pato é coelho.", "Rex é urso."], "conclusao": "Rex não é coelho."}, "vocabulario": [{"simbolo": "Urso", "tipo": "predicado", "aridade": 1, "leitura": "x é urso (ursa)"}, {"simbolo": "Pato", "tipo": "predicado", "aridade": 1, "leitura": "x é pato (pata)"}, {"simbolo": "Coelho", "tipo": "predicado", "aridade": 1, "leitura": "x é coelho (coelha)"}, {"simbolo": "rex", "tipo": "constante", "aridade": 0, "leitura": "Rex"}], "gabarito": {"premissas": ["∀x (Urso(x) ⟹ Pato(x))", "∀x (Pato(x) ⟹ Coelho(x))", "Urso(rex)"], "conclusao": "¬Coelho(rex)", "classe": "contradiz"}}
{"id": "P-011", "texto": {"premissas": ["Todo pato é macaco.", "Bob não é pato."], "conclusao": "Bob não é macaco."}, "vocabulario": [{"simbolo": "Pato", "tipo": "predicado", "aridade": 1, "leitura": "x é pato (pata)"}, {"simbolo": "Macaco", "tipo": "predicado", "aridade": 1, "leitura": "x é macaco (macaca)"}, {"simbolo": "bob", "tipo": "constante", "aridade": 0, "leitura": "Bob"}], "gabarito": {"premissas": ["∀x (Pato(x) ⟹ Macaco(x))", "¬Pato(bob)"], "conclusao": "¬Macaco(bob)", "classe": "independente"}}
{"id": "P-012", "texto": {"premissas": ["Todo pato é ruidoso.", "Mel não é ruidosa."], "conclusao": "Mel não é pata."}, "vocabulario": [{"simbolo": "Pato", "tipo": "predicado", "aridade": 1, "leitura": "x é pato (pata)"}, {"simbolo": "Ruidoso", "tipo": "predicado", "aridade": 1, "leitura": "x é ruidoso"}, {"simbolo": "mel", "tipo": "constante", "aridade": 0, "leitura": "Mel"}], "gabarito": {"premissas": ["∀x (Pato(x) ⟹ Ruidoso(x))", "¬Ruidoso(mel)"], "conclusao": "¬Pato(mel)", "classe": "segue"}}
